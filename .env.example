# Copy to .env at the repository root: cp .env.example .env
# daemon/.env is a symlink to it, because Bun loads .env from the daemon's
# working directory. Never commit .env.
#
# Pick ONE provider option. See docs/providers.md.

# --- Option A: Google Gemini ----------------------------------------------
# One key covers both extraction (chat) and embeddings.
GEMINI_API_KEY=

# --- Option B: any OpenAI-compatible endpoint ------------------------------
# Setting ANY of these six selects option B, and then all six are required.
# Chat and embeddings are separate because they are often different vendors.
# NOVA_CHAT_BASE_URL=https://api.openai.com/v1
# NOVA_CHAT_API_KEY=
# NOVA_CHAT_MODEL=gpt-4.1-mini
# NOVA_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# NOVA_EMBED_API_KEY=
# NOVA_EMBED_MODEL=gemini-embedding-001
#
# Optional. Only 1536 is supported; any other value is refused at startup.
# NOVA_EMBED_DIM=1536

# --- Who you are (recommended) ----------------------------------------------
# Lets Nova tell what you owe from what others owe you. Without it, Nova keeps
# only loops whose direction the text makes plain.
# NOVA_USER_NAME=Sam Lee
# NOVA_USER_ALIASES=Sam,sam@example.com

# --- Overrides (rarely needed) ------------------------------------------------
# NOVA_SQLCIPHER=/opt/homebrew/opt/sqlcipher/lib/libsqlcipher.dylib
# NOVA_CAPTURE_BIN=/path/to/nova-capture
