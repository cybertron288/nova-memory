# Nova Cloud proxy environment. Copy the values into Vercel → nova-cloud →
# Settings → Environment Variables (Preview and Production); Vercel can import
# this file as-is once filled in. Never commit a filled-in copy.
# Every variable is checked at start; a missing or invalid one stops the proxy.

# --- Model provider (OpenAI-compatible) -------------------------------------
# Use paid tiers whose terms neither keep inputs nor train on them.
UPSTREAM_CHAT_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_CHAT_API_KEY=
UPSTREAM_CHAT_MODEL=deepseek-chat

# Must return 1536-dimension embeddings.
UPSTREAM_EMBED_BASE_URL=
UPSTREAM_EMBED_API_KEY=
UPSTREAM_EMBED_MODEL=

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://fsnbdmyzuxxpfycndqhw.supabase.co
# Project Settings → API Keys → service_role. Bypasses all row-level security:
# server only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cost control ------------------------------------------------------------
# Spend at which Nova Cloud pauses for everyone until the month ends.
NOVA_MONTHLY_CEILING_USD=5
# USD per million tokens, from each provider's pricing page. Must be above 0.
NOVA_PRICE_CHAT_IN=
NOVA_PRICE_CHAT_OUT=
NOVA_PRICE_EMBED=

# --- Abuse limits --------------------------------------------------------------
# At least 32 characters: openssl rand -hex 32
NOVA_IP_HASH_SECRET=
# Optional. Requests per IP per day, and new accounts per IP per day.
NOVA_IP_DAILY_LIMIT=5000
NOVA_IP_SIGNUP_LIMIT=3
